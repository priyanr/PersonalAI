# Copy to .env and adjust as needed. All values have sensible defaults in docker-compose.yml.

# Host ports
API_PORT=5080
WEB_PORT=3000

# Data volume paths (relative to this file, or absolute)
OLLAMA_DATA_PATH=./data/ollama
SQLITE_DATA_PATH=./data/sqlite
WORKSPACE_DATA_PATH=./data/workspace

# UID the API container runs as (the .NET image default). The one-shot `api-init` service chowns the two
# bind-mounted folders above to this UID so the non-root API can write its SQLite db and workspace.
# API_UID=1654

# --- Authentication (optional) -------------------------------------------------------------------
# Delegated login via an external OAuth2 / OpenID Connect provider, REST/bearer-token style: the
# API hands the provider's access/refresh tokens back to the frontend as JSON, which stores them
# in localStorage and sends them as an Authorization header -- no auth cookies. Leave
# AUTH_ENABLED=false to run PersonalAI wide open (fine for a single user on localhost). To enable:
# register PersonalAI as a client on the provider with AUTH_REDIRECT_URI below as an allowed redirect
# URI (the frontend's own callback route, not the API's), then fill these in. See README.md
# "Authentication" for provider-specific examples.
AUTH_ENABLED=false
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Option A: a standard OIDC provider (Keycloak, Auth0, Okta, Entra ID, Authentik, ...) ---------
# Endpoints and signing keys (JWKS) come from {AUTH_AUTHORITY}/.well-known/openid-configuration.
AUTH_AUTHORITY=
AUTH_USE_DISCOVERY=true
# offline_access is what grants a refresh token on most providers.
AUTH_SCOPE=openid profile offline_access
# The API identifier access tokens are issued for (checked against `aud`); Auth0 also needs it
# passed at login as Auth__AuthorizeParameters__audience.
# AUTH_AUDIENCE=
# AUTH_ISSUER=
# Where the provider sends the browser after logout; must be registered with the provider.
# AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
# client_secret_post (default) or client_secret_basic.
# AUTH_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post

# --- Option B: a plain OAuth2 provider without OIDC discovery --------------------------------------
# Set AUTH_USE_DISCOVERY=false and list the endpoints explicitly (absolute URLs, or paths relative to
# AUTH_AUTHORITY). If the provider signs its JWT access tokens with a shared HMAC secret instead of
# publishing a JWKS, put that secret in AUTH_JWT_KEY (it must match the provider's key exactly).
# AUTH_USE_DISCOVERY=false
# AUTH_AUTHORIZATION_ENDPOINT=/oauth2/authorize
# AUTH_TOKEN_ENDPOINT=/oauth2/token
# AUTH_REVOCATION_ENDPOINT=/oauth2/revoke
# AUTH_INTROSPECTION_ENDPOINT=/oauth2/introspect
# AUTH_END_SESSION_ENDPOINT=
# AUTH_JWT_KEY=

# --- Sandbox (optional) ---------------------------------------------------------------------------
# PersonalAI.SandboxHost -- the broker that dials out from the Docker host to the API's sandbox
# WebSocket and runs the `sandbox` tool's containers/file ops. SANDBOX_HOST_KEY is a shared secret
# given to both the api and sandboxhost services; empty disables the sandbox. Generate one with e.g.
#   openssl rand -hex 32        (or, in PowerShell: [guid]::NewGuid().ToString("N"))
# SANDBOX_HOST_PATH is the directory on the DOCKER HOST that becomes each sandbox's persistent storage
# -- see src/PersonalAI.SandboxHost/README.md's bind-mount warning before changing it.
SANDBOX_HOST_KEY=
SANDBOX_HOST_PATH=/data/sandbox
SANDBOX_HOST_ID=docker-compose
SANDBOX_BROKER_API_URL=ws://api:8080/api/sandbox/host
